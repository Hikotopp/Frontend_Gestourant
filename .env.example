# For local Vite development, leave empty to use the configured development proxy.
# Docker serves the frontend and API on one origin; keep this empty there too.
VITE_API_URL=

# Public DNS name pointing to the Oracle VM public IPv4 address (no scheme).
DOMAIN=

# Generate unique random values; never commit the completed .env file.
MYSQL_DATABASE=gestourant
MYSQL_USER=gestourant_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
ADMIN_REGISTRATION_CODE=

# Configure both values together only when enabling Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional OAuth providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional S3-compatible destination for administrator backups.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=gestourant/backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
